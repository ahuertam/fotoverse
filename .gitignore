# ======================================================================
# fotoverse .gitignore
# ======================================================================
# Comentarios indican por qué se ignora cada bloque. Lo importante: el
# repositorio debe clonarse pequeño y reproducible. Nada de binarios ni
# artefactos locales debe acabar en git por accidente.

# --- Sistema operativo ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.directory
.Trash-*

# --- Editores ---
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.cursor/
.aider*

# --- Node / pnpm ---
node_modules/
.pnpm-store/
.pnp.*
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.vite/
*.tsbuildinfo
.parcel-cache

# --- Rust / Cargo ---
src-tauri/target/
src-tauri/Cargo.lock
**/*.rs.bk
*.pdb

# --- Tauri build artifacts (binarios de release) ---
src-tauri/target/release/
src-tauri/target/debug/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/bundle/
src-tauri/.tauri/

# --- App bundles (los installers no van al repo, los genera el release) ---
*.app
*.dmg
*.exe
*.msi
*.deb
*.rpm
*.AppImage
*.zip
*.tar.gz
*.blockmap

# --- Frontend build output ---
dist/
build/
out/
.vite/
.next/
.parcel-cache/

# --- Base de datos local (estado del usuario, no versionar) ---
fotoverse.db
fotoverse.db-journal
fotoverse.db-wal
fotoverse.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# --- Thumbnails cache (regenerable) ---
thumb-cache/
thumbs/

# --- Logs ---
*.log
logs/
.fotoverse/
fotoverse.log

# --- Entorno y secrets locales ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
secrets/
config.local.*

# --- Tests y fixtures temporales ---
tmp/
temp/
fixtures/run/
coverage/
.nyc_output/
*.lcov

# --- OS extra ---
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- TypeScript ---
*.tsbuildinfo
dist-types/
types/
# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas
